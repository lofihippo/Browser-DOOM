{
  "name": "browser-doom",
  "version": "1.0.0",
  "description": "A playable, fully client-side DOOM that runs in the browser. Bundles the doomgeneric WebAssembly engine (GPL-2.0) and Freedoom Phase 1 game data, with runtime loading of user WADs.",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "start": "http-server -p 8080 -c-1",
    "dev": "http-server -p 8080 -c-1"
  },
  "keywords": [
    "doom",
    "wasm",
    "webassembly",
    "browser-game",
    "retro-gaming",
    "freedoom",
    "doomgeneric"
  ],
  "author": "Browser DOOM Team",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lofihippo/Browser-DOOM"
  },
  "bugs": {
    "url": "https://github.com/lofihippo/Browser-DOOM/issues"
  },
  "homepage": "https://github.com/lofihippo/Browser-DOOM#readme"
}
